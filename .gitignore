# Build output (regenerated by idf.py)
build/
build_c5/
sdkconfig
sdkconfig.old

# Fetched by the IDF component manager (idf.py build downloads these)
managed_components/

# Vendor's proprietary stock firmware — never redistribute; back up your own
firmware_backup/

# Local tooling / editor / OS cruft
.claude/
.cache/
.clangd/
.vscode/
.devcontainer/
.DS_Store
.env
*.pyc
__pycache__/
tmp/
dist/
releases/
PROGRESS.md
docs/pic/
*.HEIC

# Firmware binaries are distributed via GitHub Releases, not committed to the repo.
# (They stay on disk locally so you can upload them with `gh release create`.)
release/firmware/*.bin

# Note: dependencies.lock IS committed on purpose (pins exact component versions
# for reproducible builds). release/ docs + manifest ARE committed.
